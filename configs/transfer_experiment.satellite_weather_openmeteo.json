{
  "schema_version": "transfer-experiment-v2",
  "paths": {
    "slovenian_dataset": "outputs/transfer_experiment_satellite_pilot/prepared_satellite/slovenia.parquet",
    "finnish_dataset": "outputs/transfer_experiment_satellite_pilot/prepared_satellite/finnish.parquet",
    "output_root": "outputs/transfer_experiment_satellite_weather_openmeteo",
    "slovenian_checkpoint_root": "models/tft_slovenia_satellite_weather_openmeteo",
    "fold_model_root": "models/tft_finnish_folds_satellite_weather_openmeteo",
    "final_model_root": "models/tft_finnish_final_satellite_weather_openmeteo"
  },
  "weather": {
    "enabled": true,
    "provider": "open-meteo",
    "mode": "historical",
    "model": "ecmwf_ifs025",
    "cache_dir": "data/cache/openmeteo"
  },
  "tft": {
    "point_loss": "mae-heavy",
    "batch_size": 64,
    "max_sequences_per_epoch": 10000,
    "patience": 5,
    "weather_enabled": true,
    "satellite_enabled": true,
    "satellite_encoder_only": true
  }
}
